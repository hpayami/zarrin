fn first_even(n: int) -> int {
    for i in 0..n {
        if i > 0 && i % 2 == 0 { return i; }
    }
    return 0 - 1;
}
fn scan(n: int) -> int {
    let i = 0;
    while i < n {
        if i == 3 { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
fn main() {
    print(first_even(10));
    print(scan(10));
    print(scan(2));
}
