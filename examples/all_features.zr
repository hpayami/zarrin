// Zarrin comprehensive feature test
// Tests: functions, structs, enums, traits, impl, macros, extern fns, match, if/while/break

macro double(x) {
    return x + x;
}

struct Point {
    x: int,
    y: int
}

trait Show {
    fn show(self) -> string;
}

impl Show for Point {
    fn show(self) -> string {
        return "Point";
    }
}

impl Point {
    fn distance(self) -> float {
        return 5.0;
    }
}

enum Color {
    Red,
    Green,
    Blue,
    Rgb(int, int, int)
}

fn add(x: int, y: int) -> int {
    return x + y;
}

fn main() {
    print("=== Zarrin Feature Test ===");

    // Functions + arithmetic
    let a = add(3, 4);
    print(a);

    // Macro
    let b = double(10);
    print(b);

    // Struct + field access
    let p = Point { x: 10, y: 20 };
    print(p.x);

    // Trait method
    print(p.show());

    // Inherent impl method
    let d = p.distance();
    print(d);

    // Enum variants
    let c = Blue;
    print(c);
    let c2 = Rgb(255, 128, 0);
    print(c2);

    // Match
    let v = match c {
        Red => 1,
        Green => 2,
        Blue => 3,
        _ => 0,
    };
    print(v);

    // String concat
    let s = "hello " + "world";
    print(s);

    // If expression
    let x = 5;
    let r = if x > 3 { 100 } else { 0 };
    print(r);

    // While loop
    let i = 0;
    while i < 5 {
        i = i + 1;
    }
    print(i);

    // for loop over a range, with continue
    let evens = 0;
    for k in 0..10 {
        if k % 2 == 1 { continue; }
        evens = evens + k;
    }
    print(evens);

    // string builtins and escape sequences
    print(substring("hello world", 6, 11));
    print(contains("hello", "ell"));
    print(trim("  padded  "));
    print("tab\tsep");
    print("a brace \{ stays put \}");

    // arrays
    let xs = [10, 20, 30];
    print(xs[1]);
    print(len(xs));
    // a whole array, and a whole struct, print like the value they are
    print(xs);
    print("xs = {xs}");
    print(p);

    // Option, and a match with a guard and a qualified pattern
    let maybe = Some(41);
    if maybe.is_some() { print(maybe.unwrap() + 1); }
    let grade = match a {
        n if n > 100 => "big",
        7 => "lucky",
        _ => "other",
    };
    print(grade);
    print(match c { Color::Blue => "blue", _ => "not blue" });

    // a struct built by a function, read back through its fields
    let q = shifted(p);
    print(q.x);
    print(q.y);

    print("=== All features passed! ===");
}

fn shifted(src: Point) -> Point {
    return Point { x: src.x + 1, y: src.y + 1 };
}
